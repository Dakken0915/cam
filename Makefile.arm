# 使用 IMX6ULL Buildroot SDK 交叉编译
CXX      = arm-buildroot-linux-gnueabihf-g++
CXXFLAGS = -std=c++14 -Wall -Wextra -O2 -g -Iinclude

OPENCV_ARM = $(HOME)/opencv_arm_install
CXXFLAGS += -I$(OPENCV_ARM)/include/opencv4
LDFLAGS  = -L$(OPENCV_ARM)/lib
LDFLAGS  += -lopencv_core -lopencv_imgproc -lopencv_imgcodecs -lpthread

SRC_DIR = src
OBJ_DIR = build_arm

COMMON_SRCS = $(SRC_DIR)/v4l2.cpp $(SRC_DIR)/jpeg_encoder.cpp $(SRC_DIR)/http_server.cpp $(SRC_DIR)/framebuffer.cpp
HEADERS = $(wildcard include/*.hpp)

cam_server_arm: $(OBJ_DIR)/cam_server_arm

$(OBJ_DIR)/cam_server_arm: $(SRC_DIR)/main.cpp $(COMMON_SRCS) $(HEADERS)
	@mkdir -p $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $< $(COMMON_SRCS) -o $@ $(LDFLAGS)

clean:
	rm -rf $(OBJ_DIR)

.PHONY: cam_server_arm clean
